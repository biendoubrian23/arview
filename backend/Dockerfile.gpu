ARG CUDA_IMAGE=nvidia/cuda:13.0.2-devel-ubuntu22.04
FROM ${CUDA_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_ARCHITECTURES=120
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
ARG BUILD_OPENMVS=0

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TORCH_CUDA_ARCH_LIST=8.9 \
    CUDA_HOME=/usr/local/cuda \
    ARVIEW_WORK_DIR=/workspace/jobs

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    ffmpeg \
    git \
    libatlas-base-dev \
    libboost-filesystem-dev \
    libboost-graph-dev \
    libboost-iostreams-dev \
    libboost-program-options-dev \
    libboost-regex-dev \
    libboost-serialization-dev \
    libboost-system-dev \
    libboost-test-dev \
    libcgal-dev \
    libceres-dev \
    libcurl4-openssl-dev \
    libeigen3-dev \
    libfreeimage-dev \
    libglew-dev \
    libglfw3-dev \
    libgoogle-glog-dev \
    libgtest-dev \
    libjpeg-dev \
    libmetis-dev \
    libopencv-dev \
    libopenimageio-dev \
    libpng-dev \
    libsqlite3-dev \
    libtiff-dev \
    libxi-dev \
    libxmu-dev \
    ninja-build \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    qtbase5-dev \
    libqt5opengl5-dev \
    blender \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip setuptools wheel

COPY requirements.txt /tmp/arview-requirements.txt
RUN pip install -r /tmp/arview-requirements.txt

RUN pip install torch torchvision --index-url ${PYTORCH_INDEX_URL} \
    && pip install nerfstudio gsplat

RUN apt-get update && apt-get install -y --no-install-recommends openimageio-tools \
    && rm -rf /var/lib/apt/lists/*

RUN pip install "cmake>=3.30,<4"

RUN git clone --depth 1 https://github.com/colmap/colmap.git /tmp/colmap \
    && cmake -S /tmp/colmap -B /tmp/colmap/build -GNinja \
      -DCMAKE_BUILD_TYPE=Release \
      -DGUI_ENABLED=OFF \
      -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} \
    && cmake --build /tmp/colmap/build --target install --parallel $(nproc) \
    && rm -rf /tmp/colmap

RUN apt-get update && apt-get install -y --no-install-recommends libnanoflann-dev \
    && rm -rf /var/lib/apt/lists/*

RUN if [ "${BUILD_OPENMVS}" = "1" ]; then \
      git clone --depth 1 --recursive https://github.com/cdcseacave/openMVS.git /tmp/openMVS \
      && cmake -S /tmp/openMVS -B /tmp/openMVS/build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DOpenMVS_USE_CUDA=ON \
        -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} \
      && cmake --build /tmp/openMVS/build --target install --parallel $(nproc) \
      && rm -rf /tmp/openMVS ; \
    else \
      echo "Skipping OpenMVS build"; \
    fi

COPY . /app
RUN mkdir -p /workspace/jobs

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
